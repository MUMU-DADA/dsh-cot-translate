{
  "name": "dsh-cot-translate",
  "version": "0.1.0",
  "private": true,
  "description": "Display-layer translation of DSH reasoning with local-model-first translation and multilingual UI.",
  "type": "module",
  "main": "lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "cordis.patch.yml",
    "README*.md",
    "docs/",
    "LICENSE",
    "THIRD_PARTY_LICENSES.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-general"
      ]
    }
  },
  "scripts": {
    "build": "npm run build:clean && npm run build:host && npm run build:client && npm run build:types",
    "build:clean": "node -e \"require('node:fs').rmSync('lib',{recursive:true,force:true})\"",
    "build:host": "node scripts/build-host.mjs",
    "build:client": "node scripts/build-client.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "pretest": "npm run build",
    "test": "node --test",
    "i18n:status": "node scripts/i18n-status.mjs",
    "slots": "node scripts/dump-slots.mjs",
    "build:types": "node scripts/build-types.mjs",
    "prepare": "npm run build"
  },
  "engines": {
    "node": "^22.19.0 || >=24"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "cot",
    "chain-of-thought",
    "reasoning",
    "translation",
    "local-llm",
    "llama.cpp"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-client-ui-chat": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.0-rc.2",
    "@deepseek-ai/dsh-settings": "0.2.0-rc.2",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-chat": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-conversation": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-slots": {
      "optional": true
    },
    "@deepseek-ai/dsh-settings": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.1",
    "esbuild": "^0.28.0",
    "jsdom": "^30.1.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "typescript": "^5.9.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/MUMU-DADA/dsh-cot-translate.git"
  },
  "homepage": "https://github.com/MUMU-DADA/dsh-cot-translate#readme",
  "bugs": {
    "url": "https://github.com/MUMU-DADA/dsh-cot-translate/issues"
  }
}
